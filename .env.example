# MySQL connection for metadata (projects, sessions, logs)
DATABASE_URL="mysql://deepsonar:strongpassword@127.0.0.1:3306/deep_sonar"

# 32-byte hex key for AES-256-GCM encryption of stored DB configs
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="change_me_64_hex_chars_aabbccddeeff00112233445566778899aabbccddeeff"

# Admin password for dashboard login
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN="change_me"

OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="nomic-embed-text"

PORT=3000
NODE_ENV=production
NEXTAUTH_SECRET="change_me"
NEXTAUTH_URL="http://your-vps-ip:3000"

# TTL in seconds (default: 3600 = 1 hour)
SESSION_TTL_SECONDS=3600

# Max requests per minute per API key
RATE_LIMIT_MAX=100

# In-memory cache refresh interval in ms (default: 5 minutes)
VECTOR_CACHE_TTL_MS=300000

# Concurrent rows per Ollama batch - 10 is safe for a 2 vCPU VPS
INGEST_BATCH_SIZE=10